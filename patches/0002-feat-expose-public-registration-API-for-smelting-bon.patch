-    private SmeltingBonuses() {
+    public static void register(ItemStack input, Item bonus) {
+        if (input.isEmpty() || bonus == null) {
+            return;
+        }
+        register(input.getItem(), bonus);
+    }
+
+    public static void register(Item input, Item bonus) {
+        if (input == null || input == Items.AIR || bonus == null) {
+            return;
+        }
+        ITEMS.add(new ItemEntry(() -> input, () -> bonus));
+        RESOLVED.clear();
     }
 
