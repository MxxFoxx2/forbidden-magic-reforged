diff --git a/src/main/java/thaumcraft/aspect/AspectRegistrar.java b/src/main/java/thaumcraft/aspect/AspectRegistrar.java
index 2b53f17..7d0f4d0 100644
--- a/src/main/java/thaumcraft/aspect/AspectRegistrar.java
+++ b/src/main/java/thaumcraft/aspect/AspectRegistrar.java
@@ -56,6 +56,13 @@ public abstract class AspectRegistrar {
         }
     }
 
+    protected void block(String target, AspectList aspects) {
+        BuiltInRegistries.BLOCK.getOptional(Identifier.parse(target)).ifPresentOrElse(
+            block -> registry.registerBlock(block, aspects.copy()),
+            () -> Thaumcraft.LOGGER.debug("Aspect block target {} is not registered", target)
+        );
+    }
+
     protected void entity(String target, AspectList aspects, Object... nbt) {
         BuiltInRegistries.ENTITY_TYPE.getOptional(Identifier.parse(target)).ifPresentOrElse(
             type -> registry.registerEntity(type, aspects.copy(), nbt),
diff --git a/src/main/java/thaumcraft/aspect/AspectRegistry.java b/src/main/java/thaumcraft/aspect/AspectRegistry.java
index e444f2e..3f5826a 100644
--- a/src/main/java/thaumcraft/aspect/AspectRegistry.java
+++ b/src/main/java/thaumcraft/aspect/AspectRegistry.java
@@ -18,6 +18,7 @@ import net.minecraft.world.item.ItemStackTemplate;
 import net.minecraft.world.item.Items;
 import net.minecraft.world.item.crafting.CraftingInput;
 import net.minecraft.world.item.crafting.Ingredient;
+import net.minecraft.world.level.block.Block;
 import net.minecraft.world.item.crafting.Recipe;
 import net.minecraft.world.item.crafting.RecipeHolder;
 import net.minecraft.world.item.crafting.ShapedRecipe;
@@ -33,6 +34,7 @@ public final class AspectRegistry {
     private static volatile AspectRegistry active = new AspectRegistry();
 
     private final Map<Item, AspectList> tags = new HashMap<>();
+    private final Map<Block, AspectList> blockTags = new HashMap<>();
     private final Map<EntityType<?>, List<EntityAspects>> entities = new HashMap<>();
     private final Map<Item, List<CraftingSource>> craftingByOutput = new HashMap<>();
     private final Map<Item, List<CraftingSource>> processingByOutput = new HashMap<>();
@@ -57,9 +59,10 @@ public final class AspectRegistry {
         active = registry;
     }
 
-    public static AspectRegistry fromSync(Map<Item, AspectList> tags, Map<EntityType<?>, List<EntityAspects>> entities) {
+    public static AspectRegistry fromSync(Map<Item, AspectList> tags, Map<Block, AspectList> blockTags, Map<EntityType<?>, List<EntityAspects>> entities) {
         AspectRegistry registry = new AspectRegistry();
         tags.forEach((item, aspects) -> registry.tags.put(item, aspects.copy()));
+        blockTags.forEach((block, aspects) -> registry.blockTags.put(block, aspects.copy()));
         entities.forEach((type, list) -> registry.entities.put(type, new ArrayList<>(list)));
         return registry;
     }
@@ -68,6 +71,14 @@ public final class AspectRegistry {
         tags.put(item, aspects == null ? new AspectList() : aspects.copy());
     }
 
+    public void registerBlock(Block block, @Nullable AspectList aspects) {
+        blockTags.put(block, aspects == null ? new AspectList() : aspects.copy());
+    }
+
+    public @Nullable AspectList getBlockTags(Block block) {
+        return cap(blockTags.get(block));
+    }
+
     public boolean exists(Item item) {
         return tags.containsKey(item);
     }
@@ -170,6 +181,16 @@ public final class AspectRegistry {
         return result;
     }
 
+    public Map<Block, AspectList> exportBlockTags() {
+        Map<Block, AspectList> result = new LinkedHashMap<>();
+        blockTags.forEach((block, aspects) -> {
+            if (!aspects.isEmpty()) {
+                result.put(block, aspects.copy());
+            }
+        });
+        return result;
+    }
+
     public Map<EntityType<?>, List<EntityAspects>> exportEntities() {
         Map<EntityType<?>, List<EntityAspects>> result = new LinkedHashMap<>();
         entities.forEach((type, list) -> result.put(type, List.copyOf(list)));
diff --git a/src/main/java/thaumcraft/aspect/AspectSync.java b/src/main/java/thaumcraft/aspect/AspectSync.java
index 2ea28c1..71be5fa 100644
--- a/src/main/java/thaumcraft/aspect/AspectSync.java
+++ b/src/main/java/thaumcraft/aspect/AspectSync.java
@@ -34,7 +34,7 @@ public final class AspectSync {
             rebuild(event.getPlayerList().getServer());
         }
         AspectRegistry registry = AspectRegistry.active();
-        AspectTagsPayload payload = new AspectTagsPayload(registry.exportTags(), registry.exportEntities());
+        AspectTagsPayload payload = new AspectTagsPayload(registry.exportTags(), registry.exportBlockTags(), registry.exportEntities());
         event.getRelevantPlayers().forEach(player -> ModNetwork.sendToPlayer(player, payload));
     }
 
diff --git a/src/main/java/thaumcraft/client/ClientPayloadHandlers.java b/src/main/java/thaumcraft/client/ClientPayloadHandlers.java
